<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

   <modelVersion>4.0.0</modelVersion>

   <parent>
      <groupId>org.exoplatform.commons-exo</groupId>
      <artifactId>commons-exo</artifactId>
      <version>7.3.x-ai-contribution-SNAPSHOT</version>
   </parent>

   <artifactId>exo.core.component.connector.credentials</artifactId>

   <name>Meeds:: PLF Core :: Component :: Connector Credentials Contract</name>
   <description>Shared contract for pluggable connector credentials providers (Personal, technical account, OAuth...) consumed by connectors (email, CalDAV, CardDAV) to obtain channel-typed, ready-to-use credentials material.</description>

   <properties>
      <exo.test.coverage.ratio>0.93</exo.test.coverage.ratio>
   </properties>

   <dependencies>
      <dependency>
         <groupId>io.meeds.kernel</groupId>
         <artifactId>exo.kernel.commons</artifactId>
      </dependency>
      <dependency>
         <groupId>javax.mail</groupId>
         <artifactId>javax.mail-api</artifactId>
      </dependency>
      <dependency>
         <groupId>org.springframework</groupId>
         <artifactId>spring-context</artifactId>
         <scope>provided</scope>
      </dependency>
      <!-- The module carries its own .rest layer (the provider list the admin UI reads),
           so it needs the web and security annotations. Provided: the platform supplies
           them at runtime, and a provided scope carries no transitives to the connectors
           that depend on this module. -->
      <dependency>
         <groupId>org.springframework</groupId>
         <artifactId>spring-webmvc</artifactId>
         <scope>provided</scope>
      </dependency>
      <dependency>
         <groupId>org.springframework.security</groupId>
         <artifactId>spring-security-core</artifactId>
         <scope>provided</scope>
      </dependency>
      <!-- The provider configuration is stored through SettingService, with its secret
           fields encrypted by the platform's own codec. Provided, like everything else
           here: the platform supplies both at runtime. -->
      <dependency>
         <groupId>io.meeds.portal</groupId>
         <artifactId>portal.component.api</artifactId>
         <scope>provided</scope>
      </dependency>
      <!-- io.meeds.common.ContainerTransactional, to compile the annotation. The aspect
           that reads it is woven by the parent pom's aspectj-maven-plugin, which resolves
           portal.component.common as an aspectLibrary on its own, in every module of this
           repo - this dependency neither enables nor is needed by that weaving. -->
      <dependency>
         <groupId>io.meeds.portal</groupId>
         <artifactId>portal.component.common</artifactId>
         <scope>provided</scope>
      </dependency>
      <dependency>
         <groupId>io.meeds.portal</groupId>
         <artifactId>portal.component.web.security</artifactId>
         <scope>provided</scope>
      </dependency>
      <dependency>
         <groupId>io.meeds.kernel</groupId>
         <artifactId>exo.kernel.commons.test</artifactId>
         <scope>test</scope>
      </dependency>
   </dependencies>
</project>
