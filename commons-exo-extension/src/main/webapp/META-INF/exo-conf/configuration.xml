<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.exoplatform.org/xml/ns/kernel_1_2.xsd http://www.exoplatform.org/xml/ns/kernel_1_2.xsd"
  xmlns="http://www.exoplatform.org/xml/ns/kernel_1_2.xsd">

  <!-- The mode of the Spring caches in a cluster: a Spring cache the cache configuration does not declare is created
       with it, and keeps the size and lifetime its meeds.cache.<name>.max and meeds.cache.<name>.ttl properties set -->
  <component profiles="cluster">
    <key>ClusterSpringCacheProperties</key>
    <type>org.exoplatform.container.ExtendedPropertyConfigurator</type>
    <init-params>
      <properties-param>
        <name>ClusterSpringCacheProperties</name>
        <!-- Data read from a shared store, invalidated across the nodes: only keys and hash codes travel -->
        <property name="meeds.cache.cacheMode" value="${meeds.cache.cacheMode:asyncInvalidation}" />
        <!-- Local to each node: node-local state, data nothing evicts, or keys that carry a secret -->
        <property name="meeds.cache.ai.agent.draft.cacheMode" value="${meeds.cache.ai.agent.draft.cacheMode:local}" />
        <property name="meeds.cache.ai.providers.remoteModels.cacheMode" value="${meeds.cache.ai.providers.remoteModels.cacheMode:local}" />
        <property name="meeds.cache.emailConnector.senderLogo.cacheMode" value="${meeds.cache.emailConnector.senderLogo.cacheMode:local}" />
        <property name="meeds.cache.gamification.github.organizationRepos.cacheMode" value="${meeds.cache.gamification.github.organizationRepos.cacheMode:local}" />
        <property name="meeds.cache.gamification.github.remoteOrganization.cacheMode" value="${meeds.cache.gamification.github.remoteOrganization.cacheMode:local}" />
        <property name="meeds.cache.gamification.github.tokenStatus.cacheMode" value="${meeds.cache.gamification.github.tokenStatus.cacheMode:local}" />
        <property name="meeds.cache.gamification.twitter.remoteAccount.cacheMode" value="${meeds.cache.gamification.twitter.remoteAccount.cacheMode:local}" />
      </properties-param>
    </init-params>
  </component>

  <external-component-plugins>
    <target-component>org.exoplatform.container.definition.PortalContainerConfig</target-component>
    <component-plugin>
      <name>Change PortalContainer Definitions</name>
      <set-method>registerChangePlugin</set-method>
      <type>org.exoplatform.container.definition.PortalContainerDefinitionChangePlugin</type>
      <priority>15</priority>
      <init-params>
        <value-param>
          <name>apply.default</name>
          <value>true</value>
        </value-param>
        <object-param>
          <name>change</name>
          <object type="org.exoplatform.container.definition.PortalContainerDefinitionChange$AddDependencies">
            <field name="dependencies">
              <collection type="java.util.ArrayList">
                <value>
                  <string>commons-exo-extension</string>
                </value>
              </collection>
            </field>
          </object>
        </object-param>     
      </init-params>
    </component-plugin>
  </external-component-plugins>

</configuration>
