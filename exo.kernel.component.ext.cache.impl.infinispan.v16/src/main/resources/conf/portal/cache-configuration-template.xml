<infinispan xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xmlns="urn:infinispan:config:16.0"
            xsi:schemaLocation="urn:infinispan:config:16.0 https://infinispan.org/schemas/infinispan-config-16.0.xsd">
   <threads>
      <thread-factory name="infinispan-factory" group-name="infinispan" thread-name-pattern="%G %i" priority="5"/>
   </threads>
   <cache-container default-cache="default" shutdown-hook="DEFAULT">
      <jmx enabled="true" domain="exo"/>
      <local-cache name="default">
         <locking isolation="READ_COMMITTED" concurrency-level="500" striping="false" acquire-timeout="20000"/>
         <transaction mode="NON_XA" transaction-manager-lookup="org.exoplatform.services.transaction.infinispan.JBossStandaloneJTAManagerLookup" />
         <memory max-count="1000000" when-full="REMOVE"/>
         <expiration interval="5000"/>
      </local-cache>
   </cache-container>
</infinispan>
