  <!-- Twitter Bootstrap bootstrap-affix plugin -->
  <module>
    <name>bts_affix</name>
    <load-group>bts</load-group>
    <script>
      <adapter>
        (function($) {
        var _$ = window.jQuery; window.jQuery = $;
        <include>/skin/bootstrap/js/bootstrap-affix.js</include>
        window.jQuery = _$;
        })($);
      </adapter>
    </script>
    <depends>
      <module>jquery</module>
    </depends>
  </module>

